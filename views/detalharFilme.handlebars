<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<a href="/">
  Inicial
</a><br>
<a href="/filmes">
  Filmes
</a>

<h1>Detalhar Filme</h1>

<hr>

<ul>

    <label>Nome:</label>
    {{filme.nome}}
    <br>

    <label>Ano:</label>
    {{filme.ano}}
    <br>

    <label>Diretor</label>
    <a href='/diretores/{{filme.diretor.id}}'>{{filme.diretor.nome}} - {{filme.diretor.anoNascimento}} - {{filme.diretor.nacionalidade}}</a><br>
    <br>

    <label>Artistas</label>
    <ul>
      {{#each filme.artistas}}
        <li>
          <a href='/artistas/{{this.id}}'>{{this.nome}} - {{this.anoNascimento}}</a><br>
        </li>
      {{/each}}
    </ul>

</ul>

<h1>{{filme.nome}} ({{filme.ano}})</h1>

<label>Ficha Técnica:</label>
{{#if filme.fichaTecnica}}
  <ul>
    <li>Duração: {{filme.fichaTecnica.duracaoMinutos}} minutos</li>
    <li>Orçamento: {{filme.fichaTecnica.orcamento}}</li>
    <li>Bilheteria: {{filme.fichaTecnica.bilheteria}}</li>
  </ul>
{{else}}
  <a href="/filmes/{{filme.id}}/ficha-tecnica/cadastrar">Cadastrar ficha técnica</a>
{{/if}}

<h1> ()</h1>

<label>Elenco:</label>
<ul>
  
    <li><a href="/artistas/"></a></li>
  
</ul>

<h1> ()</h1>

<label>Diretor:</label>

  <a href="/diretores/"></a>

